generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  PREMIUM
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum InterviewType {
  HR
  APTITUDE
  MANAGERIAL
  DOMAIN
}

enum InterviewModality {
  TEXT
  VOICE
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AtsScanMode {
  JOB_TARGETED
  GENERAL
}

// Candidate / regular user model
model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String?            @map("password_hash")
  googleId         String?            @unique @map("google_id")
  role             UserRole           @default(USER)
  twoFactorEnabled Boolean            @default(false) @map("2fa_enabled")
  twoFactorSecret  String?            @map("2fa_secret")
  domain           String?
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  loginLogs           LoginLog[]
  sessions            InterviewSession[]
  resumes             Resume[]
  atsScanLogs         AtsScanLog[]
  passwordResetTokens PasswordResetToken[]
  questionHistory     QuestionHistory[]
  jobDescriptions     JobDescription[]

  @@map("users")
}

// Fully isolated Admin model (separate auth system per Rules.md)
model Admin {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String     @map("password_hash")
  twoFactorEnabled Boolean    @default(true) @map("2fa_enabled") // Mandatory per architecture
  twoFactorSecret  String?    @map("2fa_secret")
  role             AdminRole  @default(ADMIN)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  loginLogs        LoginLog[]

  @@map("admins")
}

// Authentication audit log (STRICT RULE: NO IP ADDRESS LOGGING ANYWHERE)
model LoginLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  adminId   String?  @map("admin_id")
  timestamp DateTime @default(now())
  method    String   // e.g. "CREDENTIALS", "GOOGLE", "ADMIN_CREDENTIALS"
  success   Boolean

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
  @@map("login_logs")
}

enum EvaluationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  RETRYING
  FAILED
}

// Mock interview sessions
model InterviewSession {
  id           String             @id @default(cuid())
  userId       String             @map("user_id")
  type         InterviewType
  domain       String?
  focusArea    String?            @map("focus_area")
  difficulty   String?            @default("INTERMEDIATE")
  score        Float?
  masteryState Json?              @map("mastery_state")
  turnCounter  Int                @default(0) @map("turn_counter")
  modality     InterviewModality  @default(TEXT)
  startedAt    DateTime           @default(now()) @map("started_at")
  completedAt  DateTime?          @map("completed_at")
  status       SessionStatus      @default(IN_PROGRESS)

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  report         InterviewReport?
  messages       InterviewMessage[]
  evaluationJobs EvaluationJob[]
  questionHistory QuestionHistory[]
  responseAnalyses ResponseAnalysis[]
  jobDescriptionId String?         @map("job_description_id")
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id])

  @@index([userId])
  @@map("interview_sessions")
}

// Durable Evaluation Job for transactional outbox & async background evaluation
model EvaluationJob {
  id                 String              @id @default(cuid())
  idempotencyKey     String              @unique @map("idempotency_key")
  sessionId          String              @map("session_id")
  turnSequenceNumber Int                 @map("turn_sequence_number")
  pillarSlug         String              @map("pillar_slug")
  candidateMessage   String              @map("candidate_message") @db.Text
  contextHistory     Json                @map("context_history")
  status             EvaluationJobStatus @default(PENDING)
  workerId           String?             @map("worker_id")
  claimedAt          DateTime?           @map("claimed_at")
  leaseExpiresAt     DateTime?           @map("lease_expires_at")
  retryCount         Int                 @default(0) @map("retry_count")
  maxRetries         Int                 @default(3) @map("max_retries")
  timeoutMs          Int                 @default(5000) @map("timeout_ms")
  nextRetryAt        DateTime?           @map("next_retry_at")
  evaluationResult   Json?               @map("evaluation_result")
  lastError          String?             @map("last_error") @db.Text
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  session            InterviewSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, turnSequenceNumber])
  @@index([status, nextRetryAt])
  @@index([status, leaseExpiresAt])
  @@map("evaluation_jobs")
}

// Full conversation message turns for an interview session
model InterviewMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  role      String   // "user" | "assistant" | "system"
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("interview_messages")
}

// Question History for cross-session diversity and anti-repetition (Phase 6)
model QuestionHistory {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  sessionId      String   @map("session_id")
  questionText   String   @map("question_text") @db.Text
  normalizedText String   @map("normalized_text") @db.Text
  pillarIndex    Int?     @map("pillar_index")
  pillarSlug     String?  @map("pillar_slug")
  pillarName     String?  @map("pillar_name")
  track          String   // "HR" | "DOMAIN" | "MANAGERIAL" | "APTITUDE"
  domain         String?
  difficulty     String?
  questionType   String   @default("SCENARIO") @map("question_type") // "OPENING" | "SCENARIO" | "DRILL_DOWN" | "TRADEOFF" | "FOLLOW_UP"
  keyConcepts    Json?    @default("[]") @map("key_concepts")
  createdAt      DateTime @default(now()) @map("created_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, track])
  @@index([sessionId])
  @@index([normalizedText])
  @@map("question_history")
}

enum ResponseStatus {
  COMPLETED
  INTERRUPTED
  ABANDONED
  EMPTY
}

// Observable Voice & Response Analysis (Phase 7)
model ResponseAnalysis {
  id                    String           @id @default(cuid())
  sessionId             String           @map("session_id")
  turnSequenceNumber    Int              @map("turn_sequence_number")
  messageId             String?          @map("message_id")
  modality              String           @default("TEXT") // "TEXT" | "VOICE"
  responseStatus        ResponseStatus   @default(COMPLETED) @map("response_status")

  // Timing Metrics (ms, null when unavailable)
  responseLatencyMs     Int?             @map("response_latency_ms")
  answerDurationMs      Int?             @map("answer_duration_ms")
  totalTurnDurationMs   Int?             @map("total_turn_duration_ms")

  // Pause Metrics (Voice only, null for text)
  pauseCount            Int?             @map("pause_count")
  longestPauseMs        Int?             @map("longest_pause_ms")
  averagePauseMs        Int?             @map("average_pause_ms")
  totalPauseDurationMs  Int?             @map("total_pause_duration_ms")
  pausesPerMinute       Float?           @map("pauses_per_minute")
  pauseEvents           Json?            @map("pause_events")

  // Speaking Rate
  wordCount             Int              @default(0) @map("word_count")
  speakingDurationSec   Float?           @map("speaking_duration_sec")
  wordsPerMinute        Float?           @map("words_per_minute")

  // Filler Word Detection
  fillerCount           Int              @default(0) @map("filler_count")
  fillerRate            Float            @default(0.0) @map("filler_rate")
  fillerWords           Json             @default("[]") @map("filler_words")
  fillerOccurrences     Json             @default("[]") @map("filler_occurrences")

  // Disfluency Indicators
  repeatedWordCount     Int              @default(0) @map("repeated_word_count")
  repeatedPhraseCount   Int              @default(0) @map("repeated_phrase_count")
  falseStartCount       Int              @default(0) @map("false_start_count")
  disfluencyOccurrences Json             @default("[]") @map("disfluency_occurrences")

  // Communication Characteristics
  structureAssessment   String?          @map("structure_assessment")
  observableCharacteristics Json         @default("[]") @map("observable_characteristics")

  metadata              Json?            @map("metadata")
  createdAt             DateTime         @default(now()) @map("created_at")

  session               InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, turnSequenceNumber])
  @@index([sessionId])
  @@map("response_analyses")
}

enum ReportStatus {
  GENERATING
  WAITING_FOR_EVALUATIONS
  READY
  PARTIAL
  FAILED
}

enum SynthesisStatus {
  SYNTHESIS_PENDING
  SYNTHESIS_GENERATING
  SYNTHESIS_READY
  SYNTHESIS_FAILED
}

// Evaluator report generated after an interview session
model InterviewReport {
  id                      String           @id @default(cuid())
  sessionId               String           @unique @map("session_id")
  status                  ReportStatus     @default(GENERATING)
  overallScore            Float?           @map("overall_score")
  overallPerformanceLevel String?          @map("overall_performance_level")
  startingDifficulty      String?          @map("starting_difficulty")
  finalDifficulty         String?          @map("final_difficulty")
  difficultyTrajectory    Json?            @map("difficulty_trajectory")
  metrics                 Json?
  pillarScores            Json?            @map("pillar_scores")
  reconciliation          Json?
  scores                  Json?            @default("{}")
  strengths               Json?            @default("[]")
  weaknesses              Json?            @default("[]")
  tips                    Json?            @default("[]")
  lastError               String?          @map("last_error") @db.Text
  metadata                Json?

  // Phase 4B-1: Qualitative LLM Report Synthesis
  synthesisStatus         SynthesisStatus  @default(SYNTHESIS_PENDING) @map("synthesis_status")
  executiveSummary        String?          @map("executive_summary") @db.Text
  structuredStrengths     Json?            @map("structured_strengths")
  structuredWeaknesses    Json?            @map("structured_weaknesses")
  structuredTips          Json?            @map("structured_tips")
  synthesisModel          String?          @map("synthesis_model")
  synthesisPromptVersion  String?          @map("synthesis_prompt_version")
  synthesisCreatedAt      DateTime?        @map("synthesis_created_at")
  synthesisUpdatedAt      DateTime?        @map("synthesis_updated_at")
  synthesisError          String?          @map("synthesis_error") @db.Text

  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  session                 InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([synthesisStatus])
  @@map("interview_reports")
}

// Uploaded candidate resumes
model Resume {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  fileUrl     String       @map("file_url")
  fileName    String       @map("file_name")
  fileSize    Int          @map("file_size")
  parsedData  Json?        @map("parsed_data") // Structured extraction: skills, experience, education
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  atsScanLogs AtsScanLog[]

  @@index([userId])
  @@map("resumes")
}

// ATS scoring & suggestion logs
model AtsScanLog {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  resumeId    String      @map("resume_id")
  mode        AtsScanMode
  jdId        String?     @map("jd_id")
  jdText      String?     @map("jd_text")
  score       Float
  suggestions Json        // Formatting fixes, keyword gaps, phrasing improvements
  timestamp   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume      Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@map("ats_scan_logs")
}

// Time-limited, single-use password reset tokens (only SHA-256 hash stored)
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}


model JobDescription {
  id                        String   @id @default(cuid())
  userId                    String   @map("user_id")
  rawText                   String   @db.Text
  extractedRole             String?  @map("extracted_role")
  extractedSeniority        String?  @map("extracted_seniority")
  extractedSkills           Json     @map("extracted_skills")
  extractedResponsibilities Json     @map("extracted_responsibilities")
  extractionConfidence      String   @default("unverified") @map("extraction_confidence")
  createdAt                 DateTime @default(now()) @map("created_at")
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions                  InterviewSession[]
  @@index([userId])
  @@map("job_descriptions")
}
