# ==============================================================================
# Environment Variables Example — AI Interview Preparation Assistant
# See /docs/Rules_1.md (Rules.md) for full documentation and rules.
# Rule: Never commit real secrets. Leave entries empty here.
# ==============================================================================

# PostgreSQL connection string (Railway / Supabase free tier dashboard)
DATABASE_URL=
# Direct PostgreSQL connection for migrations when using poolers (Supabase/PgBouncer)
DIRECT_URL=

# Redis connection string (Upstash free tier dashboard)
REDIS_URL=
# Upstash REST credentials (used by coding rate limiter; optional locally for in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NextAuth session encryption (Generate locally: e.g. openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# "Continue with Google" OAuth (Google Cloud Console -> OAuth credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin seed password (Required when running prisma/seed.ts; no fallback in code)
ADMIN_SEED_PASSWORD=

# Background Evaluation Worker Cron Secret (Required for /api/cron/evaluate-jobs)
CRON_SECRET=

# Transactional Email (resend.com free tier API key + sender address)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# LLM provider preference: "auto" (Groq with Gemini fallback), "groq", or "gemini"
LLM_PROVIDER=

# LLM (interview engine, evaluator) (Google AI Studio: aistudio.google.com)
GEMINI_API_KEY=
# Gemini Vision Model for OCR (Optional: defaults to gemini-2.5-flash, then gemini-2.0-flash)
GEMINI_VISION_MODEL=

# LLM alternative (console.groq.com)
GROQ_API_KEY=

# Code execution provider: "judge0" (default, skip Piston), "piston", or "auto" (Piston first, Judge0 fallback)
CODE_EXECUTION_PROVIDER=
# Code execution (if using RapidAPI's Judge0, not Piston: rapidapi.com -> Judge0 CE listing)
JUDGE0_API_KEY=

# Learning recommender (Google Cloud Console -> YouTube Data API v3)
YOUTUBE_API_KEY=

# Resume file storage (Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
